# 数据库
MYSQL_DATABASE=misakanetworks
MYSQL_USER=misaka
MYSQL_PASSWORD=请改成强密码
MYSQL_ROOT_PASSWORD=请改成强密码

# 应用密钥（必须，否则容器拒绝启动）
JWT_SECRET=请生成长度不少于32字节的随机串
IMAGE_ENCRYPTION_KEY=请生成长度恰好32字节的随机串

# 图片存储：local（服务器磁盘）或 oss
IMAGE_STORAGE_TYPE=local
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# 文档开关：生产设为 false
SWAGGER_ENABLED=false
